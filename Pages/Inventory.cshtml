@page
@model InventoryModel
@{
    ViewData["Title"] = "Inventory";
    ViewData["Active"] = "inventory";
}

<div class="page-head">
    <div>
        <h1>Inventory</h1>
        <p class="page-sub">@Model.Items.Count items · @Model.Total.ToString("N0") units on hand · @Model.LowOrOut need attention</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-ghost">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            Add item
        </button>
        <button class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V5a1 1 0 0 1 1-1h2"/><path d="M17 4h2a1 1 0 0 1 1 1v2"/><path d="M20 17v2a1 1 0 0 1-1 1h-2"/><path d="M7 20H5a1 1 0 0 1-1-1v-2"/><path d="M4 12h16"/></svg>
            Scan item
        </button>
    </div>
</div>

<div class="card">
    <div class="toolbar">
        <div class="search search-inline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" placeholder="Search by name, SKU or barcode…" aria-label="Search inventory" />
        </div>
        <div class="filter-pills">
            <button class="filter active">All</button>
            <button class="filter">In stock</button>
            <button class="filter">Low stock</button>
            <button class="filter">Out of stock</button>
        </div>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>Item</th><th>Barcode</th><th>Client</th><th>Qty</th><th>Location</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="cell-stack">
                                <span class="strong">@i.Name</span>
                                <span class="mono muted small">@i.Sku</span>
                            </div>
                        </td>
                        <td class="mono muted">@i.Barcode</td>
                        <td>@i.Client</td>
                        <td class="strong">@i.Qty.ToString("N0")</td>
                        <td><span class="loc">@i.Location</span></td>
                        <td><span class="badge tone-@i.Tone">@i.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
