@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["Active"] = "home";
}

<div class="page-head">
    <div>
        <h1>Welcome back, Jordan</h1>
        <p class="page-sub">Here's what's happening across your inventory today.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-ghost">Export</button>
        <button class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V5a1 1 0 0 1 1-1h2"/><path d="M17 4h2a1 1 0 0 1 1 1v2"/><path d="M20 17v2a1 1 0 0 1-1 1h-2"/><path d="M7 20H5a1 1 0 0 1-1-1v-2"/><path d="M4 12h16"/></svg>
            Start scanning
        </button>
    </div>
</div>

<section class="stat-grid">
    @foreach (var s in Model.Stats)
    {
        <div class="card stat">
            <div class="stat-ico tone-@s.Tone">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 7 9-4 9 4-9 4-9-4Z"/><path d="M3 7v10l9 4 9-4V7"/></svg>
            </div>
            <div class="stat-body">
                <span class="stat-label">@s.Label</span>
                <span class="stat-value">@s.Value</span>
            </div>
            <span class="trend @(s.TrendUp ? "up" : "down")">
                @(s.TrendUp ? "▲" : "▼") @s.Trend
            </span>
        </div>
    }
</section>

<section class="grid-2">
    <div class="card">
        <div class="card-head">
            <h2>Recent scans</h2>
            <a class="link" href="/Inventory">View all</a>
        </div>
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr><th>Item</th><th>SKU</th><th>Client</th><th>Time</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.RecentScans)
                    {
                        <tr>
                            <td class="strong">@r.Item</td>
                            <td class="mono muted">@r.Sku</td>
                            <td>@r.Client</td>
                            <td class="muted">@r.Time</td>
                            <td><span class="badge tone-@r.Tone">@r.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <h2>Scans this week</h2>
            <span class="pill">7 days</span>
        </div>
        <div class="chart">
            @foreach (var b in Model.Week)
            {
                var h = (int)Math.Round(b.Value * 100.0 / Model.WeekMax);
                <div class="chart-col">
                    <div class="bar" style="height:@(h)%" title="@b.Value scans"></div>
                    <span class="chart-x">@b.Day</span>
                </div>
            }
        </div>
    </div>
</section>

<section class="card">
    <div class="card-head">
        <h2>Low stock alerts</h2>
        <a class="link" href="/Inventory">Manage</a>
    </div>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>Item</th><th>Client</th><th>On hand</th><th>Reorder at</th><th>Level</th></tr>
            </thead>
            <tbody>
                @foreach (var l in Model.LowStockItems)
                {
                    var pct = Math.Min(100, (int)Math.Round(l.Qty * 100.0 / Math.Max(1, l.Reorder)));
                    var tone = l.Qty == 0 ? "red" : "amber";
                    <tr>
                        <td class="strong">@l.Item</td>
                        <td>@l.Client</td>
                        <td>@l.Qty</td>
                        <td class="muted">@l.Reorder</td>
                        <td>
                            <div class="meter"><span class="meter-fill tone-@tone" style="width:@(pct)%"></span></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
