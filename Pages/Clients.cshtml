@page
@model ClientsModel
@{
    ViewData["Title"] = "Clients";
    ViewData["Active"] = "clients";

    string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1
            ? parts[0][..1].ToUpper()
            : (parts[0][..1] + parts[1][..1]).ToUpper();
    }
}

<div class="page-head">
    <div>
        <h1>Clients</h1>
        <p class="page-sub">@Model.Clients.Count total · @Model.ActiveCount active</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-ghost">Import</button>
        <button class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            Add client
        </button>
    </div>
</div>

<div class="card">
    <div class="toolbar">
        <div class="search search-inline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" placeholder="Search clients…" aria-label="Search clients" />
        </div>
        <div class="filter-pills">
            <button class="filter active">All</button>
            <button class="filter">Active</button>
            <button class="filter">Inactive</button>
        </div>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>Client</th><th>Contact</th><th>Items tracked</th><th>Status</th><th>Last activity</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Clients)
                {
                    var tone = c.Status == "Active" ? "green" : "gray";
                    <tr>
                        <td>
                            <div class="cell-user">
                                <span class="avatar avatar-sm">@Initials(c.Name)</span>
                                <span class="strong">@c.Name</span>
                            </div>
                        </td>
                        <td>
                            <div class="cell-stack">
                                <span>@c.Contact</span>
                                <span class="muted small">@c.Email</span>
                            </div>
                        </td>
                        <td class="strong">@c.Items.ToString("N0")</td>
                        <td><span class="badge tone-@tone">@c.Status</span></td>
                        <td class="muted">@c.LastActivity</td>
                        <td class="cell-actions">
                            <button class="icon-btn sm" aria-label="More">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
